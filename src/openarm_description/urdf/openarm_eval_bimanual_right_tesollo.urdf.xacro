  <!--
    Tomato baseline tactile symmetry correction.
    The upstream OpenArm-Tesollo model places the two tactile assemblies
    asymmetrically in rendered geometry. TS_F_A_left is the geometric source
    of truth; this entire right chain is its exact mirror about
    openarm_left_hand local y=0. Right mesh geometry uses local -X scale so
    the reflected geometry remains represented by a proper URDF link frame.
    Upstream right root: xyz="0. 0.0020218 -0.0661995"
                         rpy="-1.5707964 0. 3.1415927"
    This intentionally differs from upstream. Do not propagate it to
    /arena/lerobot or /home/zxro/openarm_tesollo.
  -->
  <joint name="TS_F_A_right_root_joint" type="fixed">
    <origin xyz="0. -0.002147 0.0661995" rpy="1.5708 0. 3.141592653589793"/>
    <parent link="openarm_left_right_finger"/>
    <child link="TS_F_A_right_base_link"/>
  </joint>
  <joint name="TS_F_A_right_tip_link_pad_joint" type="fixed">
    <origin xyz="0.0055 0.0001 -0.0942" rpy="0. 0. 0."/>
    <parent link="TS_F_A_right_tip_link"/>
    <child link="TS_F_A_right_pad"/>
  </joint>
