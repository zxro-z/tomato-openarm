  </joint>
  <link name="openarm_body_link0">
    <visual name="openarm_body_link0_visual">
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <!--
          Tomato hardware profile: the central body was physically shortened.
          body_link0_short_material_exact retains the mount plate and has a top at z=0.580 m;
          with the mount-plate top at z=0.030 m this is a 0.550 m body profile.
          Do not apply a link-wide scale: arm geometry must remain unscaled.
        -->
        <mesh filename="package://openarm_description/meshes/body/v10/visual/body_link0_short_material_exact.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision name="openarm_body_link0_collision">
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <geometry>
        <!-- Matching shortened collision mesh; keep visual and collision body height consistent for ACM. -->
        <mesh filename="package://openarm_description/meshes/body/v10/collision/body_link0_symp_short.stl" scale="0.001 0.001 0.001"/>
        <!-- <mesh filename="package://openarm_description/meshes/arm/${arm_type}/collision/${name}.stl" scale="0.001 0.001 0.001" /> -->
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
      <mass value="13.89"/>
      <inertia ixx="1.653" ixy="0.0" ixz="0.0" iyy="1.653" iyz="0.0" izz="0.051"/>
    </inertial>
  </link>
  <joint name="openarm_left_openarm_body_link0_joint" type="fixed">
    <parent link="openarm_body_link0"/>
    <child link="openarm_left_link0"/>
    <!-- Preserve the original 75 mm offset below the shortened body top: 0.698 - 0.193 = 0.505 m. -->
    <origin rpy="-1.5708 0 0" xyz="0.0 0.031 0.505"/>
