  <!-- Source-backed LeRobot table visual. Spawn pose is world identity; the MoveIt tabletop collision proxy remains separate. -->
  </xacro:if>
  <joint name="table_visual_joint" type="fixed">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <parent link="world"/>
    <child link="table_visual_link"/>
  </joint>
  <link name="table_visual_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://openarm_description/meshes/table/table_visual.obj" scale="1.0 1.0 1.0"/>
      </geometry>
      <material name="table_visual_gray">
        <color rgba="0.62 0.64 0.66 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Demo-only ros2_control model. mock_components/GenericSystem has no device I/O. -->
  <xacro:if value="$(arg use_mock_hardware)">
    <ros2_control name="OpenArmDemoMockSystem" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
      </hardware>
      <!-- Keep these GenericSystem state initial values synchronized with the
           canonical bimanual_arms/home group_state in openarm.srdf.  The
           fake arm controllers are configured to adopt these state values on
           activation rather than overwrite them with a zero command. -->
      <xacro:macro name="mock_arm_joint" params="name initial_value"><joint name="${name}"><command_interface name="position"/><state_interface name="position"><param name="initial_value">${initial_value}</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface></joint></xacro:macro>
      <xacro:mock_arm_joint name="openarm_left_joint1" initial_value="0.349065850399"/><xacro:mock_arm_joint name="openarm_left_joint2" initial_value="0.0"/><xacro:mock_arm_joint name="openarm_left_joint3" initial_value="0.0"/><xacro:mock_arm_joint name="openarm_left_joint4" initial_value="1.047197551197"/><xacro:mock_arm_joint name="openarm_left_joint5" initial_value="0.0"/><xacro:mock_arm_joint name="openarm_left_joint6" initial_value="0.0"/><xacro:mock_arm_joint name="openarm_left_joint7" initial_value="-0.767944870878"/>
      <!-- Both physical two-finger hands start open in fake execution.  At
           zero opening their collision meshes overlap before a command is sent. -->
      <xacro:macro name="mock_open_gripper_joint" params="name"><joint name="${name}"><command_interface name="position"/><state_interface name="position"><param name="initial_value">0.044</param></state_interface><state_interface name="velocity"><param name="initial_value">0.0</param></state_interface></joint></xacro:macro>
      <xacro:mock_open_gripper_joint name="openarm_left_finger_joint1"/><xacro:mock_open_gripper_joint name="openarm_left_finger_joint2"/>
      <xacro:mock_arm_joint name="openarm_right_joint1" initial_value="-0.349065850399"/><xacro:mock_arm_joint name="openarm_right_joint2" initial_value="0.0"/><xacro:mock_arm_joint name="openarm_right_joint3" initial_value="0.0"/><xacro:mock_arm_joint name="openarm_right_joint4" initial_value="1.047197551197"/><xacro:mock_arm_joint name="openarm_right_joint5" initial_value="0.0"/><xacro:mock_arm_joint name="openarm_right_joint6" initial_value="0.0"/><xacro:mock_arm_joint name="openarm_right_joint7" initial_value="0.767944870878"/>
      <xacro:mock_open_gripper_joint name="openarm_right_finger_joint1"/><xacro:mock_open_gripper_joint name="openarm_right_finger_joint2"/>
    </ros2_control>
  </xacro:if>

</robot>
